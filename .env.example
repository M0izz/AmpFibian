# AmpFibian (ClimateFit RoofLab) Configuration

# Environment
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# AWS Configuration (Optional for local development; enables DynamoDB persistence when provided)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=ampfibian_simulation_runs

# Persistence Mode: 'dynamodb' or 'local_file'
PERSISTENCE_MODE=local_file
LOCAL_STORAGE_DIR=./data/saved_runs
